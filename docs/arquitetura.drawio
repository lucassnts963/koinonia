        <mxCell id="c1d" value="profiles: authenticated s&#243; escreve username, full_name,&#10;avatar_url, mentor_id, preferred_bible_version.&#10;Progress&#227;o fica fora do alcance &#8212; RLS N&#195;O resolveria isto." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#92400E;" vertex="1" parent="1"><mxGeometry x="856" y="330" width="400" height="48" as="geometry" /></mxCell>
