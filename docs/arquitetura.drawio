        <mxCell id="titulo" value="Koinonia &#8212; arquitetura e fronteiras de confian&#231;a" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1C1917;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="30" as="geometry" /></mxCell>
        <mxCell id="subtitulo" value="O que importa aqui n&#227;o &#233; quem fala com quem, e sim COM QUAL CHAVE. Cada bug desta fase morou numa destas fronteiras." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#57534E;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="20" as="geometry" /></mxCell>
