        <mxCell id="c2d" value="21 tabelas com RLS. Discuss&#227;o vis&#237;vel se tribe_id IS NULL&#10;(acervo) ou sou membro. Vers&#237;culo de vers&#227;o licenciada s&#243;&#10;com concess&#227;o em bible_version_grants." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#1D4ED8;" vertex="1" parent="1"><mxGeometry x="856" y="424" width="400" height="48" as="geometry" /></mxCell>
