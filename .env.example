# =====================================================================
# Koinonia — variáveis de ambiente
# Copie para .env  (o .env está no .gitignore; nunca commite segredos)
# =====================================================================

# --- Domínio / TLS -----------------------------------------------------
# O DNS (registro A / AAAA) precisa apontar para o IP da VPS ANTES do
# primeiro `up`, senão o Let's Encrypt falha a validação.
APP_DOMAIN=koinonia.example.com
ACME_EMAIL=voce@example.com

# --- Supabase ----------------------------------------------------------
# Painel do Supabase > Project Settings > API.
# As duas NEXT_PUBLIC_* são compiladas no bundle do cliente: mudou aqui,
# tem que rebuildar a imagem (`docker compose up -d --build`).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Segredo de servidor. Ignora RLS por completo — se vazar, vaza o banco
# inteiro. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ------------------------------------------------------------
# Usada pelo dicionário (actions/dictionary.ts). Opcional: sem ela o app
# sobe, mas a definição de termos falha.
OPENAI_API_KEY=

# --- Seed da Bíblia ----------------------------------------------------
# scripts/seed-bible.js conecta direto no Postgres.
#   npm run seed:bible          -> A Bíblia Livre (pt-BR)
#   npm run seed:bible kjv      -> King James (en)
# Produção:
# DATABASE_URL=postgresql://postgres:senha@db.xxxx.supabase.co:5432/postgres
# Local (npm run db:start):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Para desenvolvimento na sua máquina, veja docs/LOCAL.md — as chaves são
# as do Supabase local, não as de produção.
